# Binaries & Build Artifacts
# Executables generated by 'make build' or 'go build'
/build/
bin/
*.exe
*.exe?
*.dll
*.so
*.dylib
playground

# Performance Profiling & Test Outputs
# pprof dumps, benchmarks, and coverage reports
*.pprof
*.prof
*.out
*.test
coverage.txt
cpu.pprof
mem.pprof
pprof-cpu-mem-svg.zip
pprof-cpu.txt
pprof-mem.txt

# Go Toolchain & Workspaces
# Local workspace overrides (keep main go.mod / go.sum trackable)
go.work
go.work.sum

# Vendor directory (if not explicitly vendoring dependencies)
vendor/

# Live-Reload & Local Tooling
# Air live-reload temporary files
tmp/
.air/

# IDEs, Editors & OS Files
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# JetBrains / GoLand
.idea/
*.iws
*.iml
*.ipr

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Vim / Emacs
*.swp
*.swo
*~
